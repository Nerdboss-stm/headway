# =============================================================================
# headway-ingest credentials.  Copy to .env and fill in.  .env is gitignored.
#
# Confluent Cloud issues SEPARATE API keys per resource. A Kafka cluster key
# cannot talk to Schema Registry, and neither can call the management API.
# Mint each with:  confluent api-key create --resource <id> [--service-account sa-...]
# The secret is shown ONCE at creation time.
# =============================================================================

# --- REQUIRED: Kafka cluster (resource lkc-xxxxxx) ---------------------------
# BOOTSTRAP: Cluster settings -> Endpoints, or `confluent kafka cluster describe`.
# Strip the "SASL_SSL://" prefix; keep host:9092.
BOOTSTRAP=pkc-xxxxx.us-east-2.aws.confluent.cloud:9092
SASL_USERNAME=<cluster API key>
SASL_PASSWORD=<cluster API secret>

# --- REQUIRED: Schema Registry (resource lsrc-xxxxxx) ------------------------
# SR_URL: Environment -> Stream Governance -> Endpoint, or
#         `confluent schema-registry cluster describe`.  No trailing slash.
SR_URL=https://psrc-xxxxx.us-east-2.aws.confluent.cloud
SR_API_KEY=<schema registry API key>
SR_API_SECRET=<schema registry API secret>

# =============================================================================
# OPTIONAL below: nothing in src/ reads these. They are the credentials the
# Flink / Confluent Intelligence layer needs once you process this topic.
# =============================================================================

# --- Org + environment ids (every REST call and Terraform resource wants them)
# `confluent organization list`, `confluent environment list`
#CONFLUENT_ORG_ID=
#CONFLUENT_ENV_ID=env-xxxxx
#CONFLUENT_CLUSTER_ID=lkc-xxxxx
#CONFLUENT_SR_CLUSTER_ID=lsrc-xxxxx

# --- Cloud API key (resource "cloud") ---------------------------------------
# Org-level management plane: api.confluent.cloud, Metrics API, Terraform,
# Tableflow. NOT usable for producing or for Schema Registry.
# `confluent api-key create --resource cloud`
#CONFLUENT_CLOUD_API_KEY=
#CONFLUENT_CLOUD_API_SECRET=

# --- Flink (resource "flink-region", scoped to cloud+region, not to a cluster)
# `confluent api-key create --resource flink-region --cloud aws --region us-east-2`
# Compute pool must live in the same region as the Kafka cluster.
#FLINK_API_KEY=
#FLINK_API_SECRET=
#FLINK_COMPUTE_POOL_ID=lfcp-xxxxx
#FLINK_REST_ENDPOINT=https://flink.us-east-2.aws.confluent.cloud
#FLINK_CLOUD=aws
#FLINK_REGION=us-east-2

# --- Confluent Intelligence: model inference / Streaming Agents --------------
# The LLM key is NOT stored here at runtime: it is sealed into a Flink
# "connection" object in the same region as the compute pool, and Flink SQL
# then references the connection by name (CREATE MODEL ... / AI_COMPLETE).
# Keep it here only if you script the connection creation.
#   confluent flink connection create headway-llm --cloud aws \
#     --region us-east-2 --type openai \
#     --endpoint https://api.openai.com/v1/chat/completions --api-key sk-...
#MODEL_PROVIDER_API_KEY=
#FLINK_CONNECTION_NAME=headway-llm

# --- Confluent Intelligence: Real-Time Context Engine (MCP endpoint) --------
# Created per environment; the console shows the MCP URL and issues its own key.
#CONTEXT_ENGINE_MCP_URL=
#CONTEXT_ENGINE_API_KEY=
#CONTEXT_ENGINE_API_SECRET=
